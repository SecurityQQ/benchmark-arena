{
  "name": "openchallengelist",
  "version": "0.1.0",
  "type": "module",
  "description": "Aggregator/parser for GitHub-hosted benchmark competitions",
  "scripts": {
    "crawl": "tsx src/main.ts full",
    "process": "tsx src/main.ts process",
    "repost": "tsx src/main.ts repost",
    "live": "tsx src/main.ts live",
    "site": "tsx src/serve.ts",
    "build:site": "tsx src/build.ts",
    "db": "tsx scripts/db.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/source-serif-4": "5.3.1",
    "@octokit/plugin-throttling": "^11.0.5",
    "@octokit/rest": "^22.0.0",
    "@resvg/resvg-js": "2.6.2",
    "@vercel/functions": "3.11.1",
    "marked": "^14.0.0",
    "postgres": "3.4.9",
    "satori": "0.63.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "overrides": {
    "fflate": "0.7.5"
  }
}
