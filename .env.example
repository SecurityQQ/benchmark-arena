OPENROUTER_API_KEY=
# optional: LLM_MODEL=deepseek/deepseek-v4.1-flash
# optional: LLM_FALLBACK_MODEL=qwen/qwen3.8-flash
# optional: LLM_REASONING=off   (off | low | medium | high)
# optional: FORCE=1             (re-process every repo, ignoring the unchanged/rejected skips)
# optional: SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres   (scripts/db.ts; Supabase → Connect → Session pooler)
# optional, live board (api/live.ts; README "Live board"): GITHUB_TOKEN=   (read-only, public repositories)
# optional: LIVE_DB_URL=postgresql://ocl_live.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres   (check-ins; falls back to SUPABASE_DB_URL)
# optional: LIVE_SALT=   (salt of the IP hashes behind check-in limits)
