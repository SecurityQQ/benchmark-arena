{
  "buildCommand": "npm run build:site",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api/summary",
      "destination": "/api/summary.json"
    },
    {
      "source": "/api/people",
      "destination": "/api/people.json"
    },
    {
      "source": "/api/agents",
      "destination": "/api/agents.json"
    },
    {
      "source": "/api/open-problems",
      "destination": "/api/open-problems.json"
    },
    {
      "source": "/api/competitions",
      "destination": "/api/competitions.json"
    },
    {
      "source": "/api/competitions/:id",
      "destination": "/api/competitions/:id.json"
    },
    {
      "source": "/c/:id",
      "destination": "/"
    },
    {
      "source": "/people",
      "destination": "/"
    },
    {
      "source": "/agents",
      "destination": "/"
    },
    {
      "source": "/agents/:family",
      "destination": "/"
    },
    {
      "source": "/landing",
      "destination": "/"
    },
    {
      "source": "/submit",
      "destination": "/"
    },
    {
      "source": "/standard",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
