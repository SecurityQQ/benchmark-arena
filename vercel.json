{
  "buildCommand": "npm run build:site",
  "outputDirectory": "public",
  "redirects": [
    {
      "source": "/:path((?!api/|llms\\.txt|standard/).*)",
      "has": [
        {
          "type": "host",
          "value": "problem.md"
        }
      ],
      "destination": "https://openchallengelist.com/:path",
      "permanent": true
    },
    {
      "source": "/:path((?!api/|llms\\.txt|standard/).*)",
      "has": [
        {
          "type": "host",
          "value": "www.problem.md"
        }
      ],
      "destination": "https://openchallengelist.com/:path",
      "permanent": true
    },
    {
      "source": "/:path((?!api/|llms\\.txt|standard/).*)",
      "has": [
        {
          "type": "host",
          "value": "www.openchallengelist.com"
        }
      ],
      "destination": "https://openchallengelist.com/:path",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/summary",
      "destination": "/api/summary.json"
    },
    {
      "source": "/api/people",
      "destination": "/api/people.json"
    },
    {
      "source": "/api/agents",
      "destination": "/api/agents.json"
    },
    {
      "source": "/api/open-problems",
      "destination": "/api/open-problems.json"
    },
    {
      "source": "/api/competitions",
      "destination": "/api/competitions.json"
    },
    {
      "source": "/api/competitions/:id",
      "destination": "/api/competitions/:id.json"
    },
    {
      "source": "/c/:id",
      "destination": "/"
    },
    {
      "source": "/people",
      "destination": "/"
    },
    {
      "source": "/agents",
      "destination": "/"
    },
    {
      "source": "/agents/:family",
      "destination": "/"
    },
    {
      "source": "/landing",
      "destination": "/"
    },
    {
      "source": "/submit",
      "destination": "/"
    },
    {
      "source": "/standard",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self' https: data:; font-src 'self' https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self'; connect-src 'self' https://api.github.com https://raw.githubusercontent.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    }
  ]
}
