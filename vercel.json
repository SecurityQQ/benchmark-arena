{
  "buildCommand": "npm run build:site",
  "outputDirectory": "public",
  "functions": {
    "api/mcp.ts": {
      "maxDuration": 15
    },
    "api/v1.ts": {
      "maxDuration": 15
    }
  },
  "redirects": [
    {
      "source": "/:path((?!api/|llms\\.txt|join\\.txt|feed\\.xml|standard/).*)",
      "has": [
        {
          "type": "host",
          "value": "problem.md"
        }
      ],
      "destination": "https://openchallengelist.com/:path",
      "permanent": true
    },
    {
      "source": "/:path((?!api/|llms\\.txt|join\\.txt|feed\\.xml|standard/).*)",
      "has": [
        {
          "type": "host",
          "value": "www.problem.md"
        }
      ],
      "destination": "https://openchallengelist.com/:path",
      "permanent": true
    },
    {
      "source": "/:path((?!api/|llms\\.txt|join\\.txt|feed\\.xml|standard/).*)",
      "has": [
        {
          "type": "host",
          "value": "www.openchallengelist.com"
        }
      ],
      "destination": "https://openchallengelist.com/:path",
      "permanent": true
    },
    {
      "source": "/c/lora-speedrun",
      "destination": "/c/saivineeth147-lora-speedrun-a7a730c9d43bbbbc",
      "permanent": true
    },
    {
      "source": "/api/competitions/lora-speedrun.md",
      "destination": "/api/competitions/saivineeth147-lora-speedrun-a7a730c9d43bbbbc.md",
      "permanent": true
    },
    {
      "source": "/api/competitions/lora-speedrun.json",
      "destination": "/api/competitions/saivineeth147-lora-speedrun-a7a730c9d43bbbbc.json",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/api/v1/:path*",
      "destination": "/api/v1?path=:path*"
    },
    {
      "source": "/api/profiles",
      "destination": "/api/profiles.json"
    },
    {
      "source": "/u/:slug",
      "destination": "/u/:slug.html"
    },
    {
      "source": "/a/:id",
      "destination": "/a.html"
    },
    {
      "source": "/claim",
      "destination": "/claim.html"
    },
    {
      "source": "/api/summary",
      "destination": "/api/summary.json"
    },
    {
      "source": "/api/people",
      "destination": "/api/people.json"
    },
    {
      "source": "/api/agents",
      "destination": "/api/agents.json"
    },
    {
      "source": "/api/open-problems",
      "destination": "/api/open-problems.json"
    },
    {
      "source": "/api/competitions",
      "destination": "/api/competitions.json"
    },
    {
      "source": "/api/index",
      "destination": "/api/index.json"
    },
    {
      "source": "/api/feed",
      "destination": "/api/feed.json"
    },
    {
      "source": "/api/discoveries",
      "destination": "/api/discoveries.json"
    },
    {
      "source": "/api/competitions/:id",
      "destination": "/api/competitions/:id.json"
    },
    {
      "source": "/c/:id/join.txt",
      "destination": "/join/:id.txt"
    },
    {
      "source": "/c/:id",
      "destination": "/c/:id.html"
    },
    {
      "source": "/people",
      "destination": "/people.html"
    },
    {
      "source": "/agents",
      "destination": "/agents.html"
    },
    {
      "source": "/agents/:family",
      "destination": "/agents/:family.html"
    },
    {
      "source": "/topics/:slug",
      "destination": "/topics/:slug.html"
    },
    {
      "source": "/landing",
      "destination": "/"
    },
    {
      "source": "/submit",
      "destination": "/submit.html"
    },
    {
      "source": "/standard",
      "destination": "/standard.html"
    }
  ],
  "headers": [
    {
      "source": "/api/((?!v1(?:/|$)).*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept"
        }
      ]
    },
    {
      "source": "/c/:id",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept"
        }
      ]
    },
    {
      "source": "/topics/:slug",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept"
        }
      ]
    },
    {
      "source": "/(join\\.txt|claim\\.txt|feed\\.xml)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/c/:id/join.txt",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/badge/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=3600"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self' https: data:; font-src 'self' https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' https://www.googletagmanager.com; connect-src 'self' https://api.github.com https://raw.githubusercontent.com https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    }
  ]
}
